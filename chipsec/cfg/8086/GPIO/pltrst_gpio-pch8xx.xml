    <!--
    Pad configuration lock registers for the GPIO group that carries PLTRST# (GPP_B13).
    Layout: PADCFGLOCK_GPP_B at community offset 0x120 (800 Series PCH GPIO Community 1).
    The sideband port is supplied by the platform mm_msgbus definition.
    -->

    <!-- #################################### -->
    <!--                                      -->
    <!-- Configuration registers              -->
    <!--                                      -->
    <!-- #################################### -->
    <registers>
        <register name="PADCFGLOCK_GPP_B"   type="mm_msgbus" offset="0x120" size="4" desc="GPIO Group B Pad Configuration Lock">
            <field name="PLTRST" bit="13" size="1" desc="GPP_B13 (PLTRST#) Pad Configuration Lock"/>
        </register>
        <register name="PADCFGLOCKTX_GPP_B" type="mm_msgbus" offset="0x124" size="4" desc="GPIO Group B Pad Configuration Lock Tx">
            <field name="PLTRST" bit="13" size="1" desc="GPP_B13 (PLTRST#) Pad Configuration Lock Tx"/>
        </register>
    </registers>

    <!-- #################################### -->
    <!--                                      -->
    <!-- 'Controls'                           -->
    <!--                                      -->
    <!-- #################################### -->
    <controls>
        <control name="PltrstGpioPin"   register="PADCFGLOCK_GPP_B"   field="PLTRST" desc="Platform Reset GPIO Pin Configuration Lock"/>
        <control name="PltrstGpioPinTx" register="PADCFGLOCKTX_GPP_B" field="PLTRST" desc="Platform Reset GPIO Pin Tx Lock"/>
    </controls>

</configuration>
