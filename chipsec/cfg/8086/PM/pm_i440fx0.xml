<!--
Intel PIIX4 (82371AB) ACPI Power Management and SMBus host controller
configuration registers. Device 0:1.3 of the QEMU "pc" machine.

Source: QEMU hw/acpi/piix4.c
  - PM I/O base    : PCI config 0x40, base bits masked with 0xFFC0, enabled by 0x80[0]
  - SMBus I/O base : PCI config 0x90, base bits masked with 0xFFC0, enabled by 0xD2[0]
-->

  <!-- #################################### -->
  <!--                                      -->
  <!-- Configuration registers              -->
  <!--                                      -->
  <!-- #################################### -->
  <registers>
    <register name="ABASE"    type="pcicfg" offset="0x40" size="4" desc="ACPI Power Management Base Address">
      <field name="BA" bit="6" size="10" desc="Base Address"/>
    </register>
    <register name="SMB_BASE" type="pcicfg" offset="0x90" size="4" desc="SMBus Base Address">
      <field name="BA" bit="6" size="10" desc="Base Address"/>
    </register>
  </registers>

</configuration>
